<Window x:Class="RobloxModManager.UI.LaunchMenu.LaunchMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="28,28,28,20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
            <Image Source="/Assets/logo.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="AppNameText" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryText}"/>
            </StackPanel>
        </StackPanel>

        <Button x:Name="LaunchButton" Style="{StaticResource MenuButton}" Click="Launch_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" FontSize="20" Margin="0,0,16,0"
                           Foreground="{DynamicResource AccentBrush}"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Launch Roblox" FontWeight="SemiBold"/>
                    <TextBlock Text="Update if needed, apply your mods and start playing" FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Button>

        <Button Style="{StaticResource MenuButton}" Click="Settings_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" FontSize="20" Margin="0,0,16,0"
                           Foreground="{DynamicResource AccentBrush}"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Configure settings" FontWeight="SemiBold"/>
                    <TextBlock Text="Mods, fast flags, engine settings and more" FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Button>

        <Button Style="{StaticResource MenuButton}" Click="About_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IconText}" Text="&#xE946;" FontSize="20" Margin="0,0,16,0"
                           Foreground="{DynamicResource AccentBrush}"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="About" FontWeight="SemiBold"/>
                    <TextBlock Text="Version, credits and troubleshooting" FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Button>
    </StackPanel>
</Window>
