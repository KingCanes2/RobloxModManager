<Window x:Class="RobloxModManager.UI.Installer.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Width="640" Height="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Welcome -->
        <StackPanel x:Name="WelcomeStep" Margin="40,34,40,0">
            <Image Source="/Assets/logo.png" Width="64" Height="64" HorizontalAlignment="Left"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="WelcomeTitle" Style="{StaticResource PageTitle}" Margin="0,18,0,10" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource SecondaryText}" FontSize="14" LineHeight="21"
                       Text="It installs and updates Roblox for you, applies your mods and fast flags every time you play, and puts Roblox's settings in one place."/>
            <TextBlock Style="{StaticResource SecondaryText}" FontSize="14" LineHeight="21" Margin="0,12,0,0"
                       Text="Once installed, it opens whenever you join a game from the Roblox website."/>
            <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,22,0,0"
                       Text="Built on the design of Fishstrap and Bloxstrap (MIT License). Not affiliated with Roblox Corporation."/>
        </StackPanel>

        <!-- Location and shortcuts -->
        <StackPanel x:Name="InstallStep" Margin="40,34,40,0" Visibility="Collapsed">
            <TextBlock Style="{StaticResource PageTitle}" Text="Choose where to install"/>
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,20"
                       Text="Roblox, your mods and your settings are kept in this folder. Roblox needs about 1 GB of free space."/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LocationBox" TextChanged="Location_TextChanged"/>
                <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="Browse_Click"/>
            </Grid>
            <TextBlock x:Name="LocationError" Foreground="{DynamicResource DangerBrush}" Margin="0,8,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
            <CheckBox x:Name="DesktopShortcutBox" Content="Add a desktop shortcut" IsChecked="True" Margin="0,24,0,0"/>
            <CheckBox x:Name="StartMenuShortcutBox" Content="Add a Start menu shortcut" IsChecked="True" Margin="0,12,0,0"/>
        </StackPanel>

        <!-- Done -->
        <StackPanel x:Name="DoneStep" Margin="40,34,40,0" Visibility="Collapsed">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE930;" FontSize="40" HorizontalAlignment="Left"
                       Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock x:Name="DoneTitle" Style="{StaticResource PageTitle}" Margin="0,16,0,10" Text="You're all set"/>
            <TextBlock Style="{StaticResource SecondaryText}" FontSize="14" LineHeight="21"
                       Text="Join any game from the Roblox website and it will start through Roblox Mod Manager. The first launch downloads Roblox, which can take a few minutes."/>
            <TextBlock Style="{StaticResource SecondaryText}" FontSize="14" LineHeight="21" Margin="0,12,0,0"
                       Text="You can change mods, fast flags and other options at any time from the settings."/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SettingsButton" Content="Open settings" HorizontalAlignment="Left"
                        Visibility="Collapsed" Click="Settings_Click"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BackButton" Content="Back" MinWidth="90" Click="Back_Click"/>
                    <Button x:Name="NextButton" Content="Next" MinWidth="90" Margin="8,0,0,0"
                            Style="{StaticResource AccentButton}" IsDefault="True" Click="Next_Click"/>
                    <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" Margin="8,0,0,0"
                            IsCancel="True" Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
