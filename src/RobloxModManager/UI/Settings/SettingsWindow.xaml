<Window x:Class="RobloxModManager.UI.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Width="1020" Height="700" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <Border Background="{DynamicResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,22,18">
                    <Image Source="/Assets/logo.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="AppNameText" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <ListBox x:Name="NavList" Style="{StaticResource NavListBox}" ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="Nav_SelectionChanged">
                    <ListBoxItem Tag="Integrations">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE71B;" Margin="0,0,14,0"/>
                            <TextBlock Text="Integrations" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Mods">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xEA86;" Margin="0,0,14,0"/>
                            <TextBlock Text="Mods" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="FastFlags">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE7C1;" Margin="0,0,14,0"/>
                            <TextBlock Text="Fast flags" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="EngineSettings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE7FC;" Margin="0,0,14,0"/>
                            <TextBlock Text="Engine settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Appearance">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE790;" Margin="0,0,14,0"/>
                            <TextBlock Text="Appearance" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Behaviour">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" Margin="0,0,14,0"/>
                            <TextBlock Text="Behaviour" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Deployment">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE896;" Margin="0,0,14,0"/>
                            <TextBlock Text="Deployment" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Shortcuts">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE840;" Margin="0,0,14,0"/>
                            <TextBlock Text="Shortcuts" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="About">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE946;" Margin="0,0,14,0"/>
                            <TextBlock Text="About" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page and footer -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="36,28,28,24" Focusable="False">
                <ContentControl x:Name="PageHost" MaxWidth="880" HorizontalAlignment="Left" Focusable="False"/>
            </ScrollViewer>

            <Border Grid.Row="1" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="28,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="SaveButton" Content="Save" MinWidth="90" Style="{StaticResource AccentButton}" Click="Save_Click"/>
                        <Button Content="Save and launch Roblox" Margin="8,0,0,0" Click="SaveLaunch_Click"/>
                        <Button Content="Close" MinWidth="90" Margin="8,0,0,0" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
