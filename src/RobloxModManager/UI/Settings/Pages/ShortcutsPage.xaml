<UserControl x:Class="RobloxModManager.UI.Settings.Pages.ShortcutsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RobloxModManager.UI.Controls">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Shortcuts"/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,8"
                   Text="Choose where shortcuts appear. They're added or removed when you save."/>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Launch menu"/>

        <ctl:OptionControl Header="Desktop" Description="Opens the menu with Launch Roblox, Settings and About.">
            <CheckBox x:Name="DesktopToggle" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click"/>
        </ctl:OptionControl>

        <ctl:OptionControl Header="Start menu" Description="The same menu, from the Start menu.">
            <CheckBox x:Name="StartMenuToggle" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click"/>
        </ctl:OptionControl>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Quick actions on the desktop"/>

        <ctl:OptionControl Header="Launch Roblox" Description="Starts Roblox straight away, skipping the menu.">
            <CheckBox x:Name="PlayerToggle" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click"/>
        </ctl:OptionControl>

        <ctl:OptionControl Header="Settings" Description="Opens this window.">
            <CheckBox x:Name="SettingsToggle" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click"/>
        </ctl:OptionControl>
    </StackPanel>
</UserControl>
