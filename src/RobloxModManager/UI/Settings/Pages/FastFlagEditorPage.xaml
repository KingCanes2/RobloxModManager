<UserControl x:Class="RobloxModManager.UI.Settings.Pages.FastFlagEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Button HorizontalAlignment="Left" Margin="0,0,0,16" Click="Back_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE72B;" FontSize="12" Margin="0,0,8,0"/>
                <TextBlock Text="Fast flags"/>
            </StackPanel>
        </Button>

        <TextBlock Style="{StaticResource PageTitle}" Text="Fast flag editor"/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,20"
                   Text="Values are saved exactly as you type them. Flag names are case-sensitive."/>

        <Border Style="{StaticResource InfoBar}">
            <TextBlock TextWrapping="Wrap"
                       Text="Some flags can break Roblox or get you removed from games. Only add flags you understand, from sources you trust."/>
        </Border>

        <Grid Margin="0,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged"/>
                <TextBlock x:Name="SearchPlaceholder" Text="Search flags" Margin="12,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="Add" Style="{StaticResource AccentButton}" MinWidth="72" Click="Add_Click"/>
                <Button Content="Import JSON" Margin="8,0,0,0" Click="Import_Click"/>
                <Button Content="Copy as JSON" Margin="8,0,0,0" Click="Copy_Click"/>
                <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="Delete_Click"/>
            </StackPanel>
        </Grid>

        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,1,1,0"
                CornerRadius="8,8,0,0" Padding="24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="Value" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <ListBox x:Name="FlagList" Style="{StaticResource CardListBox}" SelectionMode="Extended" Height="380"
                 SelectionChanged="FlagList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}"/>
                        <TextBox Grid.Column="1" Margin="12,0,0,0" MinHeight="28" Padding="8,3"
                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="CountText" Style="{StaticResource SecondaryText}" Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>
