<UserControl x:Class="RobloxModManager.UI.Settings.Pages.DeploymentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RobloxModManager.UI.Controls">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Deployment"/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,20"
                   Text="See which version of Roblox is installed and choose where updates come from."/>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Installed version" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,24,6"/>
                <TextBlock x:Name="InstalledVersionText" Grid.Column="1" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="1" Text="Version ID" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,24,0"/>
                <TextBlock x:Name="InstalledGuidText" Grid.Row="1" Grid.Column="1" FontFamily="Cascadia Mono, Consolas"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.RowSpan="2" Grid.Column="2" Content="Open Roblox folder" VerticalAlignment="Center"
                        Click="OpenFolder_Click"/>
            </Grid>
        </Border>

        <ctl:OptionControl Header="Reinstall Roblox on next launch"
                           Description="Downloads a fresh copy of Roblox. Try this if Roblox crashes on start or its files are damaged.">
            <CheckBox x:Name="ReinstallToggle" Style="{StaticResource ToggleSwitch}" Click="Reinstall_Click"/>
        </ctl:OptionControl>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Channel"/>

        <ctl:OptionControl Header="Channel"
                           Description="Roblox's release track. Keep this as production unless you've been given a different channel.">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="ChannelBox" Width="190" MaxLength="64" TextChanged="Channel_TextChanged"/>
                <Button x:Name="CheckButton" Content="Check" Margin="8,0,0,0" Click="Check_Click"/>
            </StackPanel>
        </ctl:OptionControl>

        <TextBlock x:Name="ChannelInfoText" Style="{StaticResource SecondaryText}" Margin="2,0,0,0"/>
    </StackPanel>
</UserControl>
