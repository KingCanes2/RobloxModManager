<UserControl x:Class="RobloxModManager.UI.Settings.Pages.PlayHistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RobloxModManager.UI.Controls">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Play history"/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,20"
                   Text="How long you've played each game, worked out from Roblox's own log files. It stays on this PC."/>

        <ctl:OptionControl Header="Record play time"
                           Description="Roblox Mod Manager stays in the background while Roblox is open to note which game you're in.">
            <CheckBox x:Name="TrackToggle" Style="{StaticResource ToggleSwitch}" Click="Track_Click"/>
        </ctl:OptionControl>

        <ctl:OptionControl Header="Break reminder"
                           Description="A small notice in the corner of the screen after a long stretch of play. It doesn't pause or close the game.">
            <ComboBox x:Name="ReminderBox" SelectionChanged="Reminder_Changed">
                <ComboBoxItem Content="Off"/>
                <ComboBoxItem Content="After 30 minutes"/>
                <ComboBoxItem Content="After 1 hour"/>
                <ComboBoxItem Content="After 1.5 hours"/>
                <ComboBoxItem Content="After 2 hours"/>
                <ComboBoxItem Content="After 3 hours"/>
            </ComboBox>
        </ctl:OptionControl>

        <!-- Summary -->
        <UniformGrid Columns="3" Margin="0,14,0,6">
            <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Text="Last 7 days" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="WeekText" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Text="All time" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TotalText" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Days in a row" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="StreakText" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" Text="Games"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Refresh" Click="Refresh_Click"/>
                <Button x:Name="ClearButton" Content="Clear history" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="Clear_Click"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="EmptyText" Style="{StaticResource SecondaryText}"
                   Text="Nothing yet. Play a game through Roblox Mod Manager and it will show up here."/>

        <ItemsControl x:Name="GameList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" FontSize="12.5" Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <!-- share of total play time -->
                                <Grid Height="4" Margin="0,8,0,0" HorizontalAlignment="Left" Width="220">
                                    <Border Background="{DynamicResource ControlBrush}" CornerRadius="2"/>
                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="2" HorizontalAlignment="Left"
                                            Width="{Binding BarWidth}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Game page" Tag="{Binding PlaceId}" Click="OpenGame_Click"/>
                                <Button Content="Make profile" Tag="{Binding PlaceId}" Margin="8,0,0,0" Click="MakeProfile_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
