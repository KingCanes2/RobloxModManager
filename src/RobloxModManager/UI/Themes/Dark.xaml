<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="CardBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#383838"/>

    <SolidColorBrush x:Key="ControlBrush" Color="#373737"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#4A4A4A"/>

    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C8C8C8"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FCE100"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4"/>

    <SolidColorBrush x:Key="NavHoverBrush" Color="#262626"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#2F2F2F"/>

    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#3B3320"/>
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#6B5A2A"/>

    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#0C0C0C"/>
    <SolidColorBrush x:Key="TerminalTextBrush" Color="#CCCCCC"/>
</ResourceDictionary>
