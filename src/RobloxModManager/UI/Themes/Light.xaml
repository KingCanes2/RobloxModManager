<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E0E0E0"/>

    <SolidColorBrush x:Key="ControlBrush" Color="#FBFBFB"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#CFCFCF"/>

    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F5F5F"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C"/>

    <SolidColorBrush x:Key="NavHoverBrush" Color="#E2E2E2"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#DADADA"/>

    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#FFF4CE"/>
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#E8D48A"/>

    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#0C0C0C"/>
    <SolidColorBrush x:Key="TerminalTextBrush" Color="#CCCCCC"/>
</ResourceDictionary>
