<Window x:Class="RobloxModManager.UI.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="24,22,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="IconGlyph" Style="{StaticResource IconText}" FontSize="26"
                       VerticalAlignment="Top" Margin="0,0,16,0"/>

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="20"/>
                <StackPanel x:Name="DetailsPanel" Visibility="Collapsed" Margin="0,14,0,0">
                    <Button x:Name="DetailsButton" Content="Show details" HorizontalAlignment="Left" Click="Details_Click"/>
                    <TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" Padding="24,16">
            <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</Window>
