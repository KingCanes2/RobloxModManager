<Window x:Class="RobloxModManager.UI.Dialogs.AddFastFlagDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="24,22,24,18">
            <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>

            <StackPanel x:Name="SinglePanel">
                <TextBlock Text="Name" FontWeight="SemiBold"/>
                <TextBox x:Name="NameBox" Margin="0,6,0,14" TextChanged="Input_Changed"/>
                <TextBlock Text="Value" FontWeight="SemiBold"/>
                <TextBox x:Name="ValueBox" Margin="0,6,0,0" TextChanged="Input_Changed"/>
                <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,6,0,0"
                           Text="For example True, False, 60 or a piece of text."/>
            </StackPanel>

            <StackPanel x:Name="ImportPanel" Visibility="Collapsed">
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,8"
                           Text="Paste a JSON object of flag names and values, like the contents of a ClientAppSettings.json file."/>
                <TextBox x:Name="JsonBox" Height="220" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12.5" TextChanged="Input_Changed"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                       Margin="0,10,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" MinWidth="96" Style="{StaticResource AccentButton}" IsDefault="True" Click="Ok_Click"/>
                <Button Content="Cancel" MinWidth="96" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
